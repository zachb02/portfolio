# Copy this file to .env.local for local dev, or set these in your hosting
# provider's dashboard (e.g. Vercel > Project > Settings > Environment Variables)
# for production. Without these, the contact form's API route returns a clear
# "not configured" error instead of crashing.

# From twilio.com console - Account SID and Auth Token (Account Info section).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The Twilio phone number you buy/rent, in E.164 format, e.g. +15551234567.
# This is the "from" number texts are sent from.
TWILIO_FROM_NUMBER=

# Optional - overrides the hardcoded destination number (818) 300-5533.
# CONTACT_DESTINATION_NUMBER=+18183005533
